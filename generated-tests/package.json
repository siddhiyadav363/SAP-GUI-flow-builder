{
  "name": "swaglab-selenium-typescript-automation",
  "version": "1.0.0",
  "description": "Automated test suite for Swag Labs application using TypeScript, Selenium WebDriver, and Page Object Model",
  "main": "index.js",
  "scripts": {
    "test": "mocha --require ts-node/register 'src/tests/**/*.test.ts' --timeout 120000",
    "test:specific": "mocha --require ts-node/register 'src/tests/TC_AIGPMM_38_001_Complete_Checkout_Flow_Single_Product.test.ts' --timeout 120000",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "selenium",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "swag-labs",
    "pom"
  ],
  "author": "QA Automation Team",
  "license": "ISC",
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "@types/selenium-webdriver": "^4.1.20",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "selenium-webdriver": "^4.16.0"
  }
}